<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
  'https://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="com.gridcharge.mapper.UserMapper">
    <select id="findByEmail" resultType="User">SELECT * FROM tb_user WHERE email=#{email}</select>
    <select id="findById" resultType="User">SELECT * FROM tb_user WHERE id=#{id}</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO tb_user(email,nickname,role) VALUES(#{email},#{nickname},'USER')</insert>
</mapper>
